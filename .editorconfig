# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Markdown 里行尾两个空格是硬换行，删了会把段落粘在一起
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
# _index.json 之类需要人工对账，保留最终换行，方便 diff 读最后一行
insert_final_newline = true

[*.{css,scss}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
quote_type = single

[*.html]
indent_size = 2

[Makefile]
indent_style = tab
