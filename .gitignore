# ---------- 依赖 ----------
node_modules/
.pnp/
.pnp.js
.yarn/
jspm_packages/

# ---------- 构建产物 ----------
# 注意：app/dist/ 是**故意提交**的 —— 双击 index.html 就能用是本项目的主要用法，
# 不提交 dist 等于逼每个使用者先装 Node。所以这里不忽略 dist。
# 但构建中间产物要忽略：
app/dist/*.map
app/dist/assets/
*.tsbuildinfo

# ---------- 测试与缓存 ----------
coverage/
.nyc_output/
.tmp-tests/
app/node_modules/.tmp/
.vitest/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
.\#*
\#*\#

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- 环境与密钥 ----------
