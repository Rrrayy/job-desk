// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SendPreviewDialog（D13） > ★ 快照：默认状态整树进 CI（字段集变化必炸快照） 1`] = `"<header class="modal__head"><h2 class="modal__title">AI 补全暂存行</h2><button type="button" class="icon-btn" aria-label="关闭">×</button></header><div class="modal__body"><p class="field__hint" data-testid="send-preview-meta">模型 <strong>qwen2.5:7b</strong> @ <code>http://127.0.0.1:11434/v1</code> · 本机端口，请求不出公网</p><p class="field__hint">下方是这次请求会带上的内容。**只勾选你愿意发给这个模型的字段**； 取消则什么都不发送。本次确认只对这一次发送生效。</p><div data-testid="send-preview-fields"><label class="field" data-testid="preview-field-companyName"><input type="checkbox" checked=""><span class="field__label">公司名</span><span class="field__hint">字节跳动</span></label><label class="field" data-testid="preview-field-jobTitle"><input type="checkbox" checked=""><span class="field__label">岗位名</span><span class="field__hint">前端实习生</span></label><label class="field" data-testid="preview-field-status"><input type="checkbox" checked=""><span class="field__label">当前状态</span><span class="field__hint">面试中</span></label><label class="field" data-testid="preview-field-round"><input type="checkbox"><span class="field__label">当前轮次</span><span class="field__hint">2</span></label><label class="field" data-testid="preview-field-interviewKind"><input type="checkbox"><span class="field__label">面试类型</span><span class="field__hint">HR 面</span></label><label class="field" data-testid="preview-field-writtenResult"><input type="checkbox"><span class="field__label">笔试结果</span><span class="field__hint">通过</span></label><label class="field" data-testid="preview-field-note"><input type="checkbox"><span class="field__label">面经笔记原文</span><span class="field__hint">问了我 fiber 架构……</span></label><label class="field" data-testid="preview-field-lastNote"><input type="checkbox"><span class="field__label">最近沟通记录</span><span class="field__hint">上周约的二面……</span></label><label class="field" data-testid="preview-field-rawSnippet"><input type="checkbox" disabled="" checked=""><span class="field__label">用户粘贴的原文片段（必发）</span><span class="field__hint">字节 前端 25k</span></label></div></div><footer class="modal__foot"><span class="field__hint">发起方 <code>builtin:d17</code> · 已选 4 / 9 项</span><button type="button" class="btn btn--ghost">取消</button><button type="button" class="btn btn--primary" data-testid="send-preview-confirm">发送（4 项）</button></footer>"`;
